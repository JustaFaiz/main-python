"""
Excel Key Mapper - Script Version
========================================
Matches rows between two Excel files on a "key" column, pulls chosen columns
from each into one merged output sheet, and lists unmatched rows separately.

Also supports "merging" (coalescing) pairs of source columns that take turns
being populated - e.g. Column A has values for rows 1-10 and is blank
after that, Column B is blank for rows 1-10 and has values from row 11
onward. Merging them produces a single continuous output column.

No dashboard/UI - just edit the CONFIG section below and run:

    pip install openpyxl
    python excel_key_mapper.py
"""

import re
import openpyxl


# ==================== CONFIG - EDIT THIS SECTION ====================

FILE1_PATH = "file1.xlsx"
FILE1_SHEET = None          # None = active/first sheet, or e.g. "Sheet1"
FILE1_HEADER_ROW = 1        # row number containing the column names
FILE1_KEY_HEADER = "Key"    # column used for matching
FILE1_EXTRACTOR = "as_is"   # "as_is", "split_dash", or "us_digits"
FILE1_EXTRA_COLS = []       # plain extra columns to pull into the output, e.g. ["Amount", "Description"]
FILE1_KEEP_ALL_ROWS = False # True = keep every row sharing a key, False = collapse to one
FILE1_SHOW_RAW = False      # True = also output the original (pre-cleanup) key value

# Column pairs to merge/coalesce into ONE output column. For each row, the
# first non-empty value among the listed source columns (in order) is used.
# Add one dict per pair you want merged - can be more than one pair.
FILE1_MERGE_COLUMNS = [
    # {"source_columns": ["Jan-Oct Total", "Nov-Dec Total"], "output_header": "Full Year Total"},
]

FILE2_PATH = "file2.xlsx"
FILE2_SHEET = None
FILE2_HEADER_ROW = 1
FILE2_KEY_HEADER = "Key"
FILE2_EXTRACTOR = "as_is"
FILE2_EXTRA_COLS = []
FILE2_KEEP_ALL_ROWS = False
FILE2_SHOW_RAW = False

FILE2_MERGE_COLUMNS = [
    # {"source_columns": ["H1 Amount", "H2 Amount"], "output_header": "Full Year Amount"},
]

# Optional: add a "Credit" column derived from one of the extra/merged columns
# above. Set CREDIT_SOURCE_COLUMN to None to skip, or to the exact output
# header name (must be one of FILE1_EXTRA_COLS / FILE1_MERGE_COLUMNS'
# output_header / FILE2_EXTRA_COLS / FILE2_MERGE_COLUMNS' output_header).
CREDIT_SOURCE_COLUMN = None

# How to turn the source column into the Credit value:
#   "negate"              -> Credit = -source_value                (old behavior)
#   "multiply_then_negate" -> Credit = -(source_value * CREDIT_MULTIPLIER)
CREDIT_MODE = "negate"
CREDIT_MULTIPLIER = 0.21   # only used when CREDIT_MODE = "multiply_then_negate" (e.g. 0.21 for 21% US tax)

# When CREDIT_MODE = "multiply_then_negate", also show the intermediate
# multiplied value (before negating) as its own column, so both the
# 21%-of-source figure and the final negative Credit are visible.
SHOW_MULTIPLIED_COLUMN = True
MULTIPLIED_COLUMN_HEADER = "US Tax"

# Optional: rename output headers. Keys are the raw header names ("Key",
# "File1 Original Value", your extra/merged column names, "Credit"); values
# are what you want them displayed as. Leave empty to keep raw names.
DISPLAY_NAME_OVERRIDES = {
    # "Key": "Matching ID",
}

# Optional: "stack" a set of columns underneath one another instead of
# side-by-side, into a single output column. Every other column's value
# is duplicated for each stacked row (one output row per column stacked).
# Set to None/[] to skip. Add one dict per group of columns to stack -
# usually you'll only need one.
#
# Example - stack TCOA_1 and TCOA_2 (from FILE1_MERGE_COLUMNS above) into
# one continuous "TCOA" column, one below the other:
# STACK_COLUMNS = [
#     {
#         "columns": ["TCOA_1", "TCOA_2"],   # exact output header names to stack (from EXTRA_COLS/MERGE_COLUMNS/Credit/etc.)
#         "output_header": "TCOA",           # name of the resulting single column
#         "label_header": "TCOA Source",     # optional - set to None to omit; else adds a column noting which original column each row came from
#         "skip_blank": True,                # if True, rows where the stacked value is blank are dropped instead of duplicated with nothing in TCOA
#         "keep_source_columns": True,       # if True (default), TCOA_1 and TCOA_2 stay in the output as their own columns too, alongside the new stacked TCOA column. Set False to remove them and show only TCOA.
#         "row_order": "interleaved",        # "grouped" (default) = all TCOA_1 rows, then all TCOA_2 rows. "interleaved" = row1-TCOA_1, row1-TCOA_2, row2-TCOA_1, row2-TCOA_2, ...
#     },
# ]
# Rows are grouped block-style: ALL rows using the first listed column
# come first, THEN all rows using the second column - not interleaved.
STACK_COLUMNS = []

# Optional: tax-aware Debit/Credit calculation. Computes Debit = the
# amount column's value AS-IS, or multiplied by a tax rate, depending on
# which literal source column (e.g. "A"/"B"/"C"/"D") produced that row -
# and Credit = -Debit. Set to None to skip.
#
# Requires a merge dict (in FILE1_MERGE_COLUMNS/FILE2_MERGE_COLUMNS) to
# have tracked which source column won, via "track_source_as", e.g.:
#   {"source_columns": ["A", "C"], "output_header": "TCOA_1", "track_source_as": "TCOA_1 Source"}
#   {"source_columns": ["B", "D"], "output_header": "TCOA_2", "track_source_as": "TCOA_2 Source"}
# and, if TCOA_1/TCOA_2 are then stacked together, the stack config needs
# "source_field_map" + "resolved_source_header" to carry that literal
# source into one unified column, e.g.:
#   STACK_COLUMNS = [{
#       "columns": ["TCOA_1", "TCOA_2"], "output_header": "TCOA",
#       "source_field_map": {"TCOA_1": "TCOA_1 Source", "TCOA_2": "TCOA_2 Source"},
#       "resolved_source_header": "TCOA Original Column",
#       "row_order": "interleaved", "keep_source_columns": True,
#   }]
#
# DEBIT_CREDIT_CONFIG = {
#     "amount_column": "Amount",                       # output header holding the dollar amount
#     "source_label_column": "TCOA Original Column",   # output header holding the literal A/B/C/D source
#     "taxed_source_columns": ["C", "D"],               # these get multiplied by tax_multiplier; A/B pass through as-is
#     "tax_multiplier": 0.21,
#     "debit_header": "Debit",
#     "credit_header": "Credit",
# }
DEBIT_CREDIT_CONFIG = None

# Add filter dropdown arrows to the header row of the output sheet
ADD_FILTERS = True

OUTPUT_PATH = "mapped_output.xlsx"

# ==================== END CONFIG ====================


# ==================== CORE LOGIC ====================

def header_map(ws, header_row):
    result = {}
    for cell in ws[header_row]:
        if cell.value is not None:
            clean = str(cell.value).replace('\xa0', ' ').strip()
            clean = re.sub(r'\s+', ' ', clean)
            result[clean] = cell.column
    return result


def extract_identity(value):
    if value is None:
        return None
    cleaned = str(value).strip()
    return cleaned if cleaned else None


def extract_split_dash(value):
    """'US0110010 - LVL4 ...' -> 'US0110010'"""
    if value is None:
        return None
    return str(value).split(' - ')[0].strip()


def extract_us_digits(value):
    """'US 1100010J' -> 'US1100010'"""
    if value is None:
        return None
    cleaned = str(value).replace(' ', '')
    match = re.match(r'^(US\d+)', cleaned)
    return match.group(1) if match else None


EXTRACTORS = {
    "as_is": extract_identity,
    "split_dash": extract_split_dash,
    "us_digits": extract_us_digits,
}


def build_column_plan(extra_cols, merge_columns):
    """
    Combines plain extra columns and merge-column specs into two parallel
    lists: the output header name for each resulting column, and the
    "spec" used to pull each row's value.

    A spec is one of:
      - a plain column-name string
      - a tuple of column names, to coalesce (merge) - first non-blank wins
      - {"__source_of__": (col_a, col_b, ...)} - resolves to the NAME of
        whichever column in the tuple actually had a value for this row
        (not its value). Used when a merge dict includes "track_source_as",
        so later logic (e.g. tax rules) can know which literal source
        column produced each row's merged value.
    """
    output_headers = list(extra_cols)
    col_specs = list(extra_cols)
    for merge in merge_columns:
        output_headers.append(merge["output_header"])
        col_specs.append(tuple(merge["source_columns"]))
        if merge.get("track_source_as"):
            output_headers.append(merge["track_source_as"])
            col_specs.append({"__source_of__": tuple(merge["source_columns"])})
    return output_headers, col_specs


def resolve_single_value(ws, headers, row, col_name, computed):
    """
    Resolves one column name to its value for this row. Checks "computed"
    first (values already worked out earlier in this same row - e.g. an
    earlier merge's output_header), then falls back to the sheet's real
    header row. This is what lets a later merge reference an earlier
    merge's output_header as one of its own source_columns.
    """
    if computed is not None and col_name in computed:
        return computed[col_name]
    col_num = headers[col_name]
    return ws.cell(row=row, column=col_num).value


def resolve_row_value(ws, headers, row, col_spec, computed=None):
    """
    col_spec is a plain column-name string, a tuple of column names to
    coalesce (first non-blank value among them wins), or a
    {"__source_of__": (...)} dict (see build_column_plan) which resolves
    to the winning column's NAME rather than its value. "Blank" means
    None OR an empty/whitespace-only string, since exported formula cells
    (e.g. Longview/SAP) often show blank but actually contain "" rather
    than a true empty cell.
    """
    if isinstance(col_spec, dict) and "__source_of__" in col_spec:
        for col_name in col_spec["__source_of__"]:
            val = resolve_single_value(ws, headers, row, col_name, computed)
            if val is not None and str(val).strip() != '':
                return col_name   # the winning column's NAME, not its value
        return None
    if isinstance(col_spec, tuple):
        for col_name in col_spec:
            val = resolve_single_value(ws, headers, row, col_name, computed)
            if val is not None and str(val).strip() != '':
                return val
        return None
    else:
        return resolve_single_value(ws, headers, row, col_spec, computed)


def index_by_key(ws, headers, key_header, output_headers, col_specs, key_extractor, header_row, keep_all_rows):
    data = {}
    unmatched_raw = []
    key_col = headers[key_header]
    for row in range(header_row + 1, ws.max_row + 1):
        raw_val = ws.cell(row=row, column=key_col).value
        if raw_val is None:
            continue
        key = key_extractor(raw_val)
        if key is None:
            unmatched_raw.append(raw_val)
            continue
        row_values = []
        computed = {}
        for out_name, spec in zip(output_headers, col_specs):
            val = resolve_row_value(ws, headers, row, spec, computed)
            computed[out_name] = val
            row_values.append(val)
        entry = {
            'raw': raw_val,
            'values': row_values,
        }
        if keep_all_rows:
            data.setdefault(key, []).append(entry)
        else:
            data[key] = [entry]   # always store as list internally for uniform handling
    return data, unmatched_raw


def apply_debit_credit(rows, header_order, config):
    """
    rows: list of dicts (header_name -> value).
    header_order: list of header names in current output order.
    config: dict with:
        "amount_column": output header holding the dollar amount for the row.
        "source_label_column": output header holding the literal source
            column name (e.g. "A", "B", "C", "D") that produced this row -
            typically the "resolved_source_header" from a stack config, or
            a merge's "track_source_as" column.
        "taxed_source_columns": list of literal source column names that
            should have the amount multiplied by tax_multiplier. Any
            source not in this list is used as-is (multiplier 1).
        "tax_multiplier": e.g. 0.21.
        "debit_header": name of the new Debit column (default "Debit").
        "credit_header": name of the new Credit column (default "Credit"),
            always the negative of Debit.

    Returns (new_rows, new_header_order) with Debit and Credit appended.
    """
    if not config:
        return rows, header_order

    amount_col = config["amount_column"]
    source_col = config["source_label_column"]
    taxed_sources = set(config.get("taxed_source_columns", []))
    tax_multiplier = config.get("tax_multiplier", 1.0)
    debit_header = config.get("debit_header", "Debit")
    credit_header = config.get("credit_header", "Credit")

    new_header_order = list(header_order) + [debit_header, credit_header]
    new_rows = []
    for r in rows:
        new_r = dict(r)
        amount = r.get(amount_col)
        source = r.get(source_col)
        debit = multiply(amount, tax_multiplier) if source in taxed_sources else amount
        credit = negate(debit)
        new_r[debit_header] = debit
        new_r[credit_header] = credit
        new_rows.append(new_r)
    return new_rows, new_header_order


def negate(value):
    if value is None:
        return None
    try:
        return -value
    except TypeError:
        return None


def multiply(value, multiplier):
    if value is None:
        return None
    try:
        return value * multiplier
    except TypeError:
        return None


def load_sheet(path, sheet_name):
    wb = openpyxl.load_workbook(path, data_only=True)
    ws = wb[sheet_name] if sheet_name else wb.active
    return wb, ws


def resolve_extractor(name):
    if name not in EXTRACTORS:
        raise ValueError(f"Unknown extractor '{name}'. Choose from: {list(EXTRACTORS)}")
    return EXTRACTORS[name]


def apply_stacking(rows, header_order, stack_configs):
    """
    rows: list of dicts (header_name -> value), one per output row so far.
    header_order: list of header names in current output order.
    stack_configs: list of dicts, each with:
        "columns": list of header names to stack.
        "output_header": name of the resulting single stacked column.
        "label_header": optional - adds a column noting which STACKED
            column (e.g. "TCOA_1" or "TCOA_2") each row came from.
        "skip_blank": optional - drop rows where the stacked value is
            blank instead of keeping an empty one.
        "keep_source_columns": optional, defaults to True - if True, the
            original source columns (e.g. merge outputs like TCOA_1 /
            TCOA_2) stay in the output as-is, and the new stacked column
            is appended alongside them. If False, the source columns are
            removed and replaced by the stacked column (old behavior).
        "row_order": optional, defaults to "grouped":
            "grouped"     -> ALL rows for the first column, then ALL rows
                             for the second column (block by block).
            "interleaved" -> row 1's first column, row 1's second column,
                             row 2's first column, row 2's second column,
                             and so on (alternating, in original row order).
        "source_field_map": optional dict {stacked_column_name: field_name}.
            When a stacked column (e.g. "TCOA_1") is itself a merge output
            that tracked its literal winning source column (via that
            merge's "track_source_as"), this lets you carry that literal
            source (e.g. "A" or "C") along into a single unified column -
            see "resolved_source_header".
        "resolved_source_header": optional - name of the output column
            that receives the literal source column name, resolved via
            source_field_map for whichever stacked column this row is for.

    Returns (new_rows, new_header_order).
    """
    if not stack_configs:
        return rows, header_order

    new_header_order = list(header_order)
    for cfg in stack_configs:
        cols = cfg["columns"]
        keep_source = cfg.get("keep_source_columns", True)
        insert_block = [cfg["output_header"]]
        if cfg.get("label_header"):
            insert_block.append(cfg["label_header"])
        if cfg.get("resolved_source_header"):
            insert_block.append(cfg["resolved_source_header"])
        if keep_source:
            new_header_order = new_header_order + insert_block   # append at the end, originals untouched
        else:
            first_idx = new_header_order.index(cols[0])
            new_header_order = [h for h in new_header_order if h not in cols]
            insert_at = min(first_idx, len(new_header_order))
            new_header_order[insert_at:insert_at] = insert_block

    current_rows = rows
    for cfg in stack_configs:
        cols = cfg["columns"]
        output_header = cfg["output_header"]
        label_header = cfg.get("label_header")
        skip_blank = cfg.get("skip_blank", False)
        keep_source = cfg.get("keep_source_columns", True)
        row_order = cfg.get("row_order", "grouped")
        source_field_map = cfg.get("source_field_map")
        resolved_source_header = cfg.get("resolved_source_header")

        def make_row(r, col):
            val = r.get(col)
            if skip_blank and (val is None or str(val).strip() == ''):
                return None
            new_r = dict(r) if keep_source else {k: v for k, v in r.items() if k not in cols}
            new_r[output_header] = val
            if label_header:
                new_r[label_header] = col
            if resolved_source_header:
                source_field = source_field_map.get(col) if source_field_map else None
                new_r[resolved_source_header] = r.get(source_field) if source_field else None
            return new_r

        expanded = []
        if row_order == "interleaved":
            for r in current_rows:          # outer loop: each original row
                for col in cols:            # inner loop: each column, in order
                    new_r = make_row(r, col)
                    if new_r is not None:
                        expanded.append(new_r)
        else:  # "grouped"
            for col in cols:                # outer loop: one full pass per source column
                for r in current_rows:      # inner loop: every row, in original order
                    new_r = make_row(r, col)
                    if new_r is not None:
                        expanded.append(new_r)
        current_rows = expanded

    return current_rows, new_header_order


# ==================== MAIN ====================

def main():
    wb1, ws1 = load_sheet(FILE1_PATH, FILE1_SHEET)
    wb2, ws2 = load_sheet(FILE2_PATH, FILE2_SHEET)

    headers1 = header_map(ws1, FILE1_HEADER_ROW)
    headers2 = header_map(ws2, FILE2_HEADER_ROW)

    extractor1 = resolve_extractor(FILE1_EXTRACTOR)
    extractor2 = resolve_extractor(FILE2_EXTRACTOR)

    file1_output_headers, file1_col_specs = build_column_plan(FILE1_EXTRA_COLS, FILE1_MERGE_COLUMNS)
    file2_output_headers, file2_col_specs = build_column_plan(FILE2_EXTRA_COLS, FILE2_MERGE_COLUMNS)

    data1, unmatched_extract_1 = index_by_key(
        ws1, headers1, FILE1_KEY_HEADER, file1_output_headers, file1_col_specs, extractor1,
        FILE1_HEADER_ROW, FILE1_KEEP_ALL_ROWS
    )
    data2, unmatched_extract_2 = index_by_key(
        ws2, headers2, FILE2_KEY_HEADER, file2_output_headers, file2_col_specs, extractor2,
        FILE2_HEADER_ROW, FILE2_KEEP_ALL_ROWS
    )

    keys1, keys2 = set(data1), set(data2)
    matched_keys = sorted(keys1 & keys2)
    only_in_1 = sorted(keys1 - keys2)
    only_in_2 = sorted(keys2 - keys1)

    wb_out = openpyxl.Workbook()
    ws_out = wb_out.active
    ws_out.title = 'Mapped'

    raw_headers = ['Key']
    if FILE1_SHOW_RAW:
        raw_headers += ['File1 Original Value']
    raw_headers += file1_output_headers
    if FILE2_SHOW_RAW:
        raw_headers += ['File2 Original Value']
    raw_headers += file2_output_headers

    credit_idx_1 = file1_output_headers.index(CREDIT_SOURCE_COLUMN) if CREDIT_SOURCE_COLUMN in file1_output_headers else None
    credit_idx_2 = file2_output_headers.index(CREDIT_SOURCE_COLUMN) if CREDIT_SOURCE_COLUMN in file2_output_headers else None
    show_multiplied_col = CREDIT_SOURCE_COLUMN and CREDIT_MODE == "multiply_then_negate" and SHOW_MULTIPLIED_COLUMN
    if show_multiplied_col:
        raw_headers = raw_headers + [MULTIPLIED_COLUMN_HEADER]
    if CREDIT_SOURCE_COLUMN:
        raw_headers = raw_headers + ['Credit']

    display_headers = [DISPLAY_NAME_OVERRIDES.get(h, h) for h in raw_headers]

    output_rows = []   # list of dicts: {header_name: value}, before stacking
    for key in matched_keys:
        for sub2 in data2[key]:              # usually len 1 unless keep_all_rows is True
            vals2 = sub2['values']
            for sub1 in data1[key]:
                vals1 = sub1['values']
                row = [key]
                if FILE1_SHOW_RAW:
                    row.append(sub1['raw'])
                row += vals1
                if FILE2_SHOW_RAW:
                    row.append(sub2['raw'])
                row += vals2
                if CREDIT_SOURCE_COLUMN:
                    src_val = vals1[credit_idx_1] if credit_idx_1 is not None else vals2[credit_idx_2]
                    if CREDIT_MODE == "multiply_then_negate":
                        multiplied_val = multiply(src_val, CREDIT_MULTIPLIER)
                        if show_multiplied_col:
                            row.append(multiplied_val)
                        row.append(negate(multiplied_val))
                    else:  # "negate"
                        row.append(negate(src_val))
                output_rows.append(dict(zip(raw_headers, row)))

    if STACK_COLUMNS:
        output_rows, raw_headers = apply_stacking(output_rows, raw_headers, STACK_COLUMNS)
        display_headers = [DISPLAY_NAME_OVERRIDES.get(h, h) for h in raw_headers]

    if DEBIT_CREDIT_CONFIG:
        output_rows, raw_headers = apply_debit_credit(output_rows, raw_headers, DEBIT_CREDIT_CONFIG)
        display_headers = [DISPLAY_NAME_OVERRIDES.get(h, h) for h in raw_headers]

    ws_out.append(display_headers)
    output_row_count = 0
    for row_dict in output_rows:
        ws_out.append([row_dict.get(h) for h in raw_headers])
        output_row_count += 1

    if ADD_FILTERS:
        last_col_letter = ws_out.cell(row=1, column=len(raw_headers)).column_letter
        ws_out.auto_filter.ref = f"A1:{last_col_letter}{ws_out.max_row}"

    ws_unmatched = wb_out.create_sheet('Unmatched')
    ws_unmatched.append(['Reason', 'Source File', 'Raw Value', 'Extracted Key'])
    for key in only_in_1:
        for sub in data1[key]:
            ws_unmatched.append(['No match in File2', 'File1', sub['raw'], key])
    for key in only_in_2:
        for sub in data2[key]:
            ws_unmatched.append(['No match in File1', 'File2', sub['raw'], key])
    for raw_val in unmatched_extract_1:
        ws_unmatched.append(['Could not extract key', 'File1', raw_val, None])
    for raw_val in unmatched_extract_2:
        ws_unmatched.append(['Could not extract key', 'File2', raw_val, None])

    wb_out.save(OUTPUT_PATH)

    print(f"Done. Matched keys: {len(matched_keys)} | Output rows: {output_row_count}")
    print(f"Unmatched File1-only: {len(only_in_1)} | Unmatched File2-only: {len(only_in_2)}")
    print(f"Saved to: {OUTPUT_PATH}")


if __name__ == "__main__":
    main()
