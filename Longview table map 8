import re
import openpyxl

# ==================== CONFIG — edit this section ====================

FILE1 = r'file1.xlsx'      # file containing "ACCOUNTS - Symbol Name" column
SHEET1 = 'Sheet1'
HEADER_ROW_1 = 3            # row number where actual column headers are in FILE1

FILE2 = r'file2.xlsx'      # file containing "TIMEPER=" column
SHEET2 = 'Sheet1'
HEADER_ROW_2 = 3            # all headers in this file are on row 3

KEY_HEADER_1 = 'Column1'                  # header in FILE1 - already a clean key, no extraction needed
KEY_HEADER_2 = 'ACCOUNTS'                 # header in FILE2, row 3

# Extra columns to pull FROM FILE1 (besides the key)
# Include 'TAXCOLUMNS' (or its exact header name) - this is what distinguishes
# multiple sub-rows that share the same key.
COLS_FROM_1 = ['Amount', 'Cost Center', 'TAXCOLUMNS']

# Extra columns to pull FROM FILE2 (besides the key)
COLS_FROM_2 = ['Tax Code', 'Entity', 'GL Account']

# Add a 'Credit' column = negative of this column's value (must be one of COLS_FROM_1/COLS_FROM_2 above).
# Set to None to skip adding this column.
CREDIT_SOURCE_COLUMN = 'Amount'

OUTPUT_FILE = r'mapped_output.xlsx'

# Rename output headers: map the actual column name (as used above) -> what it should display as.
# Only include entries you want renamed; anything not listed keeps its original name.
DISPLAY_NAMES = {
    'Column1': 'Account Key',
    'Amount': 'Amount (USD)',
    # 'Tax Code': 'Tax Code',
}

# ==================== END CONFIG ====================


def header_map(ws, header_row=1):
    """Map header text (stripped) -> column index, reading the given header row."""
    result = {}
    for cell in ws[header_row]:
        if cell.value is not None:
            clean = str(cell.value).replace('\xa0', ' ').strip()
            clean = re.sub(r'\s+', ' ', clean)
            result[clean] = cell.column
    return result


def extract_key_identity(value):
    """For columns that are already a clean key (e.g. File1's 'Column1') - just strip whitespace."""
    if value is None:
        return None
    cleaned = str(value).strip()
    return cleaned if cleaned else None


def extract_key_from_symbol(value):
    """'ACCOUNTS - Symbol Name' e.g. 'US 1100010J' -> 'US1100010'. Returns None if no digits found."""
    if value is None:
        return None
    cleaned = str(value).replace(' ', '')
    match = re.match(r'^(US\d+)', cleaned)
    return match.group(1) if match else None


def extract_key_from_accounts(value):
    """'ACCOUNTS' e.g. 'US0110010 - LVL4 US.0.1100.10 ...' -> 'US0110010'."""
    if value is None:
        return None
    return str(value).split(' - ')[0].strip()


def index_by_key_multi(ws, headers, key_header, cols, key_extractor, header_row=1):
    """
    Like index_by_key, but preserves ALL rows sharing the same key instead of
    overwriting duplicates. Returns (dict of key -> list of {'raw','values'}, unmatched_raw list).
    """
    data = {}
    unmatched_raw = []
    key_col = headers[key_header]
    for row in range(header_row + 1, ws.max_row + 1):
        raw_val = ws.cell(row=row, column=key_col).value
        if raw_val is None:
            continue
        key = key_extractor(raw_val)
        if key is None:
            unmatched_raw.append(raw_val)
            continue
        entry = {
            'raw': raw_val,
            'values': [ws.cell(row=row, column=headers[c]).value for c in cols]
        }
        data.setdefault(key, []).append(entry)
    return data, unmatched_raw


def index_by_key(ws, headers, key_header, cols, key_extractor, header_row=1):
    """Returns (data_dict keyed by extracted key, list of raw values that failed to extract)."""
    data = {}
    unmatched_raw = []
    key_col = headers[key_header]
    for row in range(header_row + 1, ws.max_row + 1):
        raw_val = ws.cell(row=row, column=key_col).value
        if raw_val is None:
            continue
        key = key_extractor(raw_val)
        if key is None:
            unmatched_raw.append(raw_val)
            continue
        data[key] = {
            'raw': raw_val,
            'values': [ws.cell(row=row, column=headers[c]).value for c in cols]
        }
    return data, unmatched_raw


def negate(value):
    """Return the negative of a numeric value; leave non-numeric values untouched (None passthrough)."""
    if value is None:
        return None
    try:
        return -value
    except TypeError:
        return None


def main():
    wb1 = openpyxl.load_workbook(FILE1, data_only=True)
    wb2 = openpyxl.load_workbook(FILE2, data_only=True)
    ws1 = wb1[SHEET1]
    ws2 = wb2[SHEET2]

    h1 = header_map(ws1, HEADER_ROW_1)
    h2 = header_map(ws2, HEADER_ROW_2)

    data1, unmatched_extract_1 = index_by_key_multi(ws1, h1, KEY_HEADER_1, COLS_FROM_1, extract_key_identity, HEADER_ROW_1)
    data2, unmatched_extract_2 = index_by_key(ws2, h2, KEY_HEADER_2, COLS_FROM_2, extract_key_from_accounts, HEADER_ROW_2)

    keys1 = set(data1)
    keys2 = set(data2)
    matched_keys = sorted(keys1 & keys2)
    only_in_1 = sorted(keys1 - keys2)
    only_in_2 = sorted(keys2 - keys1)

    wb_out = openpyxl.Workbook()

    # --- Main mapped sheet (only fully matched rows) ---
    ws_out = wb_out.active
    ws_out.title = 'Mapped'
    raw_headers = ['Key'] + COLS_FROM_1 + COLS_FROM_2

    # Figure out where the credit source column lives (File1's values list or File2's), if configured
    credit_index_1 = COLS_FROM_1.index(CREDIT_SOURCE_COLUMN) if CREDIT_SOURCE_COLUMN in COLS_FROM_1 else None
    credit_index_2 = COLS_FROM_2.index(CREDIT_SOURCE_COLUMN) if CREDIT_SOURCE_COLUMN in COLS_FROM_2 else None
    if CREDIT_SOURCE_COLUMN and credit_index_1 is None and credit_index_2 is None:
        raise ValueError(f"CREDIT_SOURCE_COLUMN '{CREDIT_SOURCE_COLUMN}' not found in COLS_FROM_1 or COLS_FROM_2")

    if CREDIT_SOURCE_COLUMN:
        raw_headers = raw_headers + ['Credit']

    display_headers = [DISPLAY_NAMES.get(h, h) for h in raw_headers]
    ws_out.append(display_headers)

    output_row_count = 0
    for key in matched_keys:
        vals2 = data2[key]['values']
        for sub_row in data1[key]:          # one output row per sub-row sharing this key
            vals1 = sub_row['values']
            row = [key] + vals1 + vals2
            if CREDIT_SOURCE_COLUMN:
                source_val = vals1[credit_index_1] if credit_index_1 is not None else vals2[credit_index_2]
                row.append(negate(source_val))
            ws_out.append(row)
            output_row_count += 1

    # Add filter dropdown arrows on the header row (check-cell style filtering)
    last_col_letter = ws_out.cell(row=1, column=len(raw_headers)).column_letter
    ws_out.auto_filter.ref = f"A1:{last_col_letter}{ws_out.max_row}"

    # --- Unmatched sheet ---
    ws_unmatched = wb_out.create_sheet('Unmatched')
    ws_unmatched.append(['Reason', 'Source File', 'Raw Value', 'Extracted Key'])

    for key in only_in_1:
        for sub_row in data1[key]:
            ws_unmatched.append(['No match in File2', 'File1', sub_row['raw'], key])
    for key in only_in_2:
        ws_unmatched.append(['No match in File1', 'File2', data2[key]['raw'], key])
    for raw_val in unmatched_extract_1:
        ws_unmatched.append(['Could not extract key', 'File1', raw_val, None])
    for raw_val in unmatched_extract_2:
        ws_unmatched.append(['Could not extract key', 'File2', raw_val, None])

    wb_out.save(OUTPUT_FILE)

    print(f"Matched unique keys: {len(matched_keys)}")
    print(f"Total output rows (incl. sub-rows): {output_row_count}")
    print(f"Only in File1 (no match): {len(only_in_1)}")
    print(f"Only in File2 (no match): {len(only_in_2)}")
    print(f"File1 rows with unextractable key: {len(unmatched_extract_1)}")
    print(f"File2 rows with unextractable key: {len(unmatched_extract_2)}")
    print(f"Saved to {OUTPUT_FILE}")


if __name__ == '__main__':
    main()
